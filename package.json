{
  "name": "curl-snap",
  "version": "2.5.1",
  "description": "Run a curl command and render a clean, shareable card of the request and response — themed, redacted, and ready to drop into a PR, doc, or tweet.",
  "type": "module",
  "bin": {
    "curl-snap": "bin/curl-snap.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/curl-snap.js",
    "snap": "node bin/curl-snap.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "curl",
    "screenshot",
    "api",
    "pull-request",
    "evidence",
    "http",
    "cli",
    "documentation",
    "rest"
  ],
  "author": "Ian Matson (https://ian-matson.com)",
  "license": "MIT",
  "homepage": "https://github.com/imatson9119/curl-snap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imatson9119/curl-snap.git"
  },
  "bugs": {
    "url": "https://github.com/imatson9119/curl-snap/issues"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.26.0"
  }
}
